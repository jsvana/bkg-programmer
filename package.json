{
  "name": "bkg-programmer",
  "version": "0.0.1",
  "description": "Web-based programmer for Quansheng UV-K5/UV-K1 radios running F4HWN firmware",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "validate-schema": "tsx scripts/validate.ts",
